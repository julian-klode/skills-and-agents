{
  "$schema": "https://opencode.ai/config.json",
  "model": "openrouter/deepseek/deepseek-v4.1-flash-1017",
  "agents": {
    "build": {
      "mode": "primary",
      "model": "openrouter/deepseek/deepseek-v4.1-flash-1017",
     "system": "You are the Tech Lead coordinator. Do not write or edit application source code directly. For every task: 1) Break the work into an ordered list of small, self-contained stages (or 1 stage if trivial) and present the stage plan briefly. 2) Execute one stage at a time: launch `implementer` for Stage 1 (recording its session_id) and resume that same session_id for subsequent stages, passing ONLY the current stage's bounded specification. 3) After each stage completes, launch `reviewer` on Stage 1 (recording its session_id) and resume that same session_id for subsequent stages, providing ONLY the current stage's specification and asking it to inspect `git diff` (unstaged/uncommitted changes for the current stage). 4) If `reviewer` reports any BLOCKER (including premature work belonging to future stages or unrelated refactoring), resume `implementer` to fix it and resume `reviewer` until `reviewer` outputs APPROVED. 5) Once a stage is APPROVED, have `implementer` create a clean atomic git commit for that stage (if in a git repo) so the next stage starts with a clean `git diff`, then proceed to the next stage.",
      "permissions": [
        { "action": "subagent", "resource": "implementer", "effect": "allow" },
        { "action": "subagent", "resource": "reviewer", "effect": "allow" }
      ]
    }
  },
  "provider": {
    "local-llamacpp": {
      "options": {
        "baseURL": "http://10.0.0.6:8342/v1"
      },
      "models": {
        "qwen3-6-35b-a3b-ud-q4-k-m": {}
      }
    },
    "openrouter": {
      "models": {
        "deepseek/deepseek-v4.1-flash-1017": {
          "options": {
            "reasoning": {
              "effort": "low"
            },
            "provider": {
              "sort": "price",
              "allow_fallbacks": true
            }
          }
        },
        "z-ai/glm-5.3": {
          "options": {
            "reasoning": {
              "effort": "low"
            }
          }
        },
        "moonshotai/kimi-k3.1-pro": {
          "options": {
            "reasoning": {
              "effort": "high"
            }
          }
        }
      }
    }
  },
  "mcp": {
    "jira": {
      "type": "remote",
      "url": "https://mcp.atlassian.com/v1/mcp",
      "oauth": {}
    },
    "firefox-devtools": {
      "type": "local",
      "command": ["npx", "-y", "@mozilla/firefox-devtools-mcp@latest", "--connect-existing", "--marionette-port", "2828", "--tool-preset", "developer"]
    }
  }
}
